rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function spacePath() { return /databases/$(database)/documents/pub/space; }
    function isOwner() { return signedIn() && exists(spacePath()) && get(spacePath()).data.owner == request.auth.uid; }

    // Who owns this space. The first Google sign-in claims it; after that only the owner can change it.
    match /pub/space {
      allow get: if true;
      allow create: if signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // Shared projects live under sh/<place>/…, where <place> is a long random id that only that project's
    // links carry, and every document is encrypted with that project's key.
    // The sh collection itself can never be read or listed, so places cannot be discovered.
    match /sh/{place} {
      allow read, write: if false;
    }
    // Inside a known place: anyone with a session (someone who has the link) can read and write.
    match /sh/{place}/{coll}/{doc=**} {
      allow read, write: if signedIn();
    }

    // Invites: fetched by exact id (derived from a link), never listed. Only the owner creates them.
    match /inv/{id} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update, delete: if isOwner();
    }

    // Display names shown in version history: fetched one by one, never listed.
    match /people/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Each visitor's own list of projects they opened with a link.
    match /data/users/{uid}/{rest=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Everything else is the owner's private space.
    match /{coll}/{rest=**} {
      allow read, write: if coll in ['meta', 'proj', 'saves', 'live', 'assets', 'templates', 'shares'] && isOwner();
    }
  }
}
